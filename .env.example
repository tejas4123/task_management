# ============================================================================

# Task & Engagement Management Tool

# Environment Configuration Template

#

# IMPORTANT:

# - This file is a TEMPLATE only.

# - Never put real passwords, private keys, AWS access keys, or production

# secrets in this file.

# - Copy this file to `.env` on the EC2 server and replace all placeholders.

# - Production secrets should eventually be stored in AWS Secrets Manager.

# ============================================================================

# ============================================================================

# ENVIRONMENT

# ============================================================================

ENVIRONMENT=production

DJANGO_DEBUG=false

DJANGO_SECRET_KEY=REPLACE_WITH_STRONG_DJANGO_SECRET

DJANGO_ALLOWED_HOSTS=YOUR_EC2_PUBLIC_IP,YOUR_DOMAIN_NAME

# ============================================================================

# AWS

# ============================================================================

AWS_REGION=ap-south-1

# ============================================================================

# POSTGRESQL

#

# PostgreSQL is hosted in AWS RDS.

#

# IMPORTANT:

# Each microservice owns a separate logical database:

#

# auth_db

# engagement_db

# task_db

#

# All databases may exist on the same RDS PostgreSQL instance.

# ============================================================================

POSTGRES_HOST=database-1-instance-1.cni606g6a0ed.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432

POSTGRES_USER=task_admin

POSTGRES_PASSWORD=$(aws rds generate-db-auth-token --hostname $RDSHOST --port 5432 --username postgres --region ap-south-1)

# ============================================================================

# DATABASE NAMES

# ============================================================================

AUTH_DB_NAME=auth_db

ENGAGEMENT_DB_NAME=engagement_db

TASK_DB_NAME=task_db

# ============================================================================

# REDIS / CELERY

#

# Redis is hosted in AWS ElastiCache.

# ============================================================================

REDIS_HOST=YOUR_ELASTICACHE_ENDPOINT

REDIS_PORT=6379

# ============================================================================

# JWT

#

# The Auth Service signs JWTs.

# Engagement Service and Task Service verify JWTs locally.

#

# ALL services must use the same JWT secret.

# ============================================================================

JWT_SECRET_KEY=REPLACE_WITH_STRONG_SHARED_JWT_SECRET

# ============================================================================

# SERVICE-TO-SERVICE AUTHENTICATION

#

# Used by internal endpoints such as:

#

# /api/v1/internal/...

#

# The same secret should be available to trusted backend services.

# ============================================================================

INTERNAL_SERVICE_TOKEN=REPLACE_WITH_STRONG_INTERNAL_SERVICE_TOKEN

# ============================================================================

# INTERNAL SERVICE URLs

#

# These services communicate over the Docker network / private EC2 network.

#

# When all application services run through Docker Compose on the same EC2

# host, use the Docker service names below.

# ============================================================================

AUTH_SERVICE_URL=http://auth-service:8000

ENGAGEMENT_SERVICE_URL=http://engagement-service:8000

TASK_SERVICE_URL=http://task-service:8000

# ============================================================================

# TASK SERVICE

# ============================================================================

TASK_SERVICE_INTERNAL_URL=http://task-service:8000

# ============================================================================

# ENGAGEMENT SERVICE

# ============================================================================

ENGAGEMENT_SERVICE_INTERNAL_URL=http://engagement-service:8000

# ============================================================================

# CELERY

# ============================================================================

CELERY_BROKER_URL=redis://redis:6379/0

CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================================

# APPLICATION PORTS

#

# Containers can all listen on port 8000 internally.

# Docker/host mappings are configured in docker-compose.yml.

# ============================================================================

AUTH_SERVICE_PORT=8000

ENGAGEMENT_SERVICE_PORT=8000

TASK_SERVICE_PORT=8000

# ============================================================================

# LOCAL / DOCKER DEVELOPMENT REFERENCE

#

# These values are NOT used when connecting to AWS RDS/ElastiCache.

# Keep them here only as documentation.

#

# Local PostgreSQL:

# POSTGRES_HOST=postgres

# POSTGRES_PORT=5432

#

# Local Redis:

# REDIS_HOST=redis

# REDIS_PORT=6379

# ============================================================================

# ============================================================================

# SECURITY

# ============================================================================

SECURE_SSL_REDIRECT=true

SESSION_COOKIE_SECURE=true

CSRF_COOKIE_SECURE=true

# ============================================================================

# LOGGING

# ============================================================================

LOG_LEVEL=INFO

# ============================================================================

# FRONTEND API URL

#

# Replace with your public API domain or EC2/Nginx address.

# Example:

#

# https://api.example.com

# ============================================================================

VITE_AUTH_API_URL=https://YOUR_API_DOMAIN

VITE_ENGAGEMENT_API_URL=https://YOUR_API_DOMAIN

VITE_TASK_API_URL=https://YOUR_API_DOMAIN
