# ---------------------------------------------------------------------------
# Local development environment.
# Copy to .env before running `docker compose up`.
# Never commit real secrets - production values live in AWS Secrets Manager.
# ---------------------------------------------------------------------------

# PostgreSQL (single instance, one logical database per service)
POSTGRES_USER=task_admin
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_management
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AUTH_DB_NAME=auth_db
ENGAGEMENT_DB_NAME=engagement_db
TASK_DB_NAME=task_db

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379

# JWT signing key shared by every service (verification is local, no auth call)
JWT_SECRET_KEY=development-secret

# Shared secret for service-to-service (/api/v1/internal/) calls
INTERNAL_SERVICE_TOKEN=development-internal-token

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-django-secret
DJANGO_ALLOWED_HOSTS=*

# Internal service URLs (docker network names)
AUTH_SERVICE_URL=http://auth-service:8000
ENGAGEMENT_SERVICE_URL=http://engagement-service:8000
TASK_SERVICE_URL=http://task-service:8000
