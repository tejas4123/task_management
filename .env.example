# ============================================================================
# Task & Engagement Management Tool - environment template
#
# Copy to .env and replace every REPLACE_WITH_* placeholder:
#
#     cp .env.example .env
#
# This file is committed. .env is not. Never put a real password, secret key,
# AWS access key or private key here.
#
# PostgreSQL and Redis run as Docker containers in every environment - locally
# and on EC2. There is no managed database to point at.
# ============================================================================

# ----------------------------------------------------------------------------
# Django
# ----------------------------------------------------------------------------
# DJANGO_DEBUG must be false anywhere that is not a developer laptop.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_STRONG_DJANGO_SECRET

# Comma separated PUBLIC hosts only. Local development: localhost,127.0.0.1
# EC2: add the public IP (and the domain once DNS exists).
#
# The internal compose hostnames (auth-service, engagement-service,
# task-service) are always allowed by settings.py and must NOT be listed here -
# service-to-service calls send them as the Host header, and a deployment that
# listed only the public IP used to break task generation with DisallowedHost.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# CORS
#
# Comma separated browser origins allowed to call the APIs. These are origins
# (scheme + host + port), not URLs with a path.
#
# Local development (Vite dev server):  http://localhost:5173
# EC2 temporary testing (nginx image):  http://YOUR_EC2_PUBLIC_IP:3000
#
# Leave CORS_ALLOW_ALL_ORIGINS unset/false outside local development.
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=false

# ----------------------------------------------------------------------------
# PostgreSQL (Docker container `postgres`, one logical database per service)
#
# POSTGRES_DB is the bootstrap database. infra/postgres/init.sql creates
# auth_db, engagement_db and task_db on first start.
# ----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=task_management
POSTGRES_USER=task_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

AUTH_DB_NAME=auth_db
ENGAGEMENT_DB_NAME=engagement_db
TASK_DB_NAME=task_db

# ----------------------------------------------------------------------------
# Redis (Docker container `redis`) - Celery broker
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ----------------------------------------------------------------------------
# JWT
#
# The Auth Service signs; Engagement and Task verify locally with the same key.
# Every service must share this value.
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=REPLACE_WITH_STRONG_SHARED_JWT_SECRET

# ----------------------------------------------------------------------------
# Service-to-service authentication for /api/v1/internal/ endpoints
# ----------------------------------------------------------------------------
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_STRONG_INTERNAL_SERVICE_TOKEN

# ----------------------------------------------------------------------------
# Internal service URLs (Docker network names, internal port 8000)
#
# Never localhost: these are resolved inside the compose network, not by the
# browser. The 8001/8002/8003 host mappings are for humans and Postman.
# ----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:8000
ENGAGEMENT_SERVICE_URL=http://engagement-service:8000
TASK_SERVICE_URL=http://task-service:8000

# ----------------------------------------------------------------------------
# Frontend
#
# The browser API URLs are NOT set here. Vite inlines them at build time from
# frontend/.env.development and frontend/.env.production - see the README.
# ----------------------------------------------------------------------------
