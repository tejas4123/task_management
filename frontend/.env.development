# Loaded automatically by `vite` / `npm run dev` (mode = development).
#
# The browser - not a container - makes these calls, so they are the published
# host ports from docker-compose.yml, not the internal service names.
VITE_AUTH_URL=http://localhost:8001
VITE_ENGAGEMENT_URL=http://localhost:8002
VITE_TASK_URL=http://localhost:8003
