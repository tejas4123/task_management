# Loaded automatically by `npm run build` (mode = production).
#
# Vite inlines these values into the static bundle at BUILD time, so they must
# be correct before `docker compose build frontend` runs - changing them later
# requires a rebuild, not a restart.
#
# Replace EC2_PUBLIC_IP with the real address before building on the server:
#
#   sed -i "s/EC2_PUBLIC_IP/$(curl -s ifconfig.me)/g" frontend/.env.production
#
# The real IP is deliberately not committed.
VITE_AUTH_URL=http://EC2_PUBLIC_IP:8001
VITE_ENGAGEMENT_URL=http://EC2_PUBLIC_IP:8002
VITE_TASK_URL=http://EC2_PUBLIC_IP:8003
