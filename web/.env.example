# The in-memory demo adapter. It enforces the workflow map, the authorization
# rules and the duplicate constraint, so the UI runs - and demos - with no
# backend at all.
VITE_USE_MOCK=true

# Used only when VITE_USE_MOCK=false. Both adapters satisfy the same
# TypeScript interface, so this one flag swaps the whole app onto the
# live services with no component changes.
VITE_AUTH_URL=http://localhost:8001
VITE_ENGAGEMENT_URL=http://localhost:8002
VITE_TASK_URL=http://localhost:8003
